<script>
(function(){
  var root=document.documentElement;
  function setLang(l){
    root.setAttribute('data-lang',l); root.setAttribute('lang',l);
    document.querySelectorAll('.lang button').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.set===l));});
    try{localStorage.setItem('auc-lang',l);}catch(e){}
  }
  function setView(v){
    root.setAttribute('data-view',v);
    if(v==='short'){window.scrollTo({top:0,behavior:'smooth'});}
  }
  var saved=null; try{saved=localStorage.getItem('auc-lang');}catch(e){}
  var lang='es';
  if(location.hash==='#en'||location.hash==='#es') lang=location.hash.slice(1); else if(saved) lang=saved;
  setLang(lang);
  if(location.hash==='#perfil') setView('full');
  document.querySelectorAll('.lang button').forEach(function(b){b.addEventListener('click',function(){setLang(b.dataset.set);});});
  document.querySelectorAll('.toggle').forEach(function(b){b.addEventListener('click',function(){setView(b.dataset.view);});});
})();
</script>
</body>
</html>
